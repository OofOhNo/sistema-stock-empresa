# Copiá este archivo a .env y completá los valores. El .env NUNCA se sube a git.

# Puerto del servidor Express
PORT=3000

# Cadena de conexión de Neon (Dashboard > Connection Details).
# Usá la contraseña NUEVA después de rotarla. Formato:
# postgresql://USUARIO:PASSWORD@HOST/BASE?sslmode=verify-full
DATABASE_URL=

# Secreto para firmar los JWT. Generá uno largo y aleatorio, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Orígenes permitidos para CORS (separados por coma). Ej: http://localhost:5173
CORS_ORIGIN=http://localhost:5173

