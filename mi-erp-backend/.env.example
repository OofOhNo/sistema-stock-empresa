# ==============================================================================
# CONFIGURACIÓN DEL ENTORNO ERP (MI ERP - SISTEMA STOCK)
# ==============================================================================
# Copiá este archivo a .env y completá los valores reales.
# El archivo .env NUNCA se debe subir a Git (está en .gitignore).

# Puerto del servidor backend Express
PORT=3000

# ==============================================================================
# BASE DE DATOS: SUPABASE (PostgreSQL)
# ==============================================================================
# Para obtener la URL de conexión en Supabase:
# 1. Ingresá a tu Dashboard de Supabase: https://supabase.com/dashboard
# 2. Seleccioná tu proyecto -> 'Project Settings' (icono de engranaje) -> 'Database'.
# 3. En la sección 'Connection string', pestaña 'URI':
#
# Opción A (Conexión Directa - Recomendada si tu red tiene IPv4/IPv6):
# DATABASE_URL=postgresql://postgres:[TU_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
#
# Opción B (Session Pooler - Recomendada para redes exclusivamente IPv4):
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[TU_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
#
# Opción C (Transaction Pooler - Puerto 6543):
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[TU_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:[TU_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# (Opcional) Si querés exigir estricto CA TLS bundle. Por defecto en Supabase se conecta con SSL cifrado.
DATABASE_SSL_STRICT=false

# ==============================================================================
# SEGURIDAD Y JWT
# ==============================================================================
# Secreto para firmar y validar tokens JWT.
# Generá uno seguro con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=tu_secreto_super_seguro_y_largo_de_al_menos_64_caracteres

# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGIN=http://localhost:5173,http://localhost:80,http://localhost

# ==============================================================================
# FRONTEND (Para Docker / Vite)
# ==============================================================================
VITE_API_URL=/api
